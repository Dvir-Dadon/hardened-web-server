# כל בקשה לשם שלא מוגדר בשרת (כתובת IP ישירה או שם זר) מקבלת ניתוק בלי תשובה.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    ssl_reject_handshake on;
    server_name _;
    return 444;
}
